# Copy to .env (never committed) and fill in. Every value marked SECRET stays in .env on the server only.
# Lines with no value are optional; the server says at startup which features are on.

# ---- Core
# The public HTTPS address of this server (Caddy terminates TLS). No trailing slash.
PUBLIC_BASE_URL=https://desk.example.com
PORT=8080
# Which business this server answers for (a folder made by `npm run reskin`).
BUSINESS_DIR=businesses/brightside-family-dental
# SQLite file. On the droplet: /var/lib/frontdesk/frontdesk.db (the Compose file mounts a volume there).
DB_FILE=.runtime/frontdesk.db
# SECRET. Random 32+ characters; signs the deposit links in emails. Make one: openssl rand -hex 32
LINK_SECRET=

# ---- Retell (dashboard.retellai.com > API Keys; use the key that has the webhook badge)
# SECRET
RETELL_API_KEY=
# Written by `npm run retell:setup` (not secret). The phone number is bought in the Retell dashboard by you.
RETELL_AGENT_ID=
RETELL_LLM_ID=
# Caps that protect the bill. The agent hangs up at MAX_CALL_SECONDS; calls beyond MAX_CALLS_PER_DAY hear a short "demo line busy" message.
MAX_CALL_SECONDS=300
MAX_CALLS_PER_DAY=40

# ---- Google Calendar (console.cloud.google.com > IAM > Service accounts > Keys > Add key > JSON)
# Path to the downloaded JSON key file. SECRET FILE: keep it in ./secrets/ (git-ignored) or /etc/frontdesk/ on the droplet.
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
# Google Calendar > the demo calendar > Settings > Integrate calendar > Calendar ID
GOOGLE_CALENDAR_ID=

# ---- Email (resend.com > API Keys; domain verified under Domains)
# SECRET
RESEND_API_KEY=
# Sender on the verified domain. Until the domain verifies, use: Front Desk Demo <onboarding@resend.dev> (delivers only to your own Resend login email).
EMAIL_FROM=Brightside Dental (demo) <desk@mail.example.com>
# Where call summaries go when n8n is not set up, and the reply-to on caller emails.
TEAM_EMAIL=

# ---- Stripe, TEST MODE ONLY (dashboard.stripe.com > toggle Test mode > Developers > API keys). The server refuses sk_live_ keys.
# SECRET
STRIPE_SECRET_KEY=
# SECRET. Developers > Webhooks > Add endpoint: ${PUBLIC_BASE_URL}/webhooks/stripe, event checkout.session.completed > Signing secret
STRIPE_WEBHOOK_SECRET=

# ---- n8n (runs in Docker on the droplet; the server POSTs every call summary here)
# The Production URL of the n8n Webhook node, e.g. https://n8n.example.com/webhook/frontdesk-call
N8N_WEBHOOK_URL=
# SECRET. Random 32+ characters; sent as X-Frontdesk-Signature (HMAC) so n8n can reject strangers. openssl rand -hex 32
N8N_WEBHOOK_SECRET=

# ---- Read by docker-compose.yml only (droplet)
# The domain you bought. Caddy serves: DOMAIN (demo page), desk.DOMAIN (this server), n8n.DOMAIN (n8n)
DOMAIN=example.com
# Let's Encrypt contact for Caddy
ACME_EMAIL=
# SECRET. n8n encrypts its stored credentials with this. openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# Used inside n8n only (set as n8n credentials in its UI, listed here so nothing is forgotten):
#   HubSpot: app.hubspot.com > Settings > Integrations > Private Apps > scopes crm.objects.contacts.write, crm.objects.notes.write (SECRET, paste into n8n)
#   GoHighLevel: Automation > Workflows > trigger "Inbound Webhook" > copy its URL here:
GHL_INBOUND_WEBHOOK_URL=
